<!-- This launch file is for make tf of 협로주행 -->
<launch>
    <param name="/use_sim_time" value="true" />

    <node pkg="tf2_ros" type="static_transform_publisher" name="faketf" args="0 0 0 0 0 0 map base_link_gps" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="gps_base_to_base" args="-0.60 0 -1.23 0 0 0 base_link_gps base_link" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_lidar" args="0.82 0 0.45 0 0 0 base_link velodyne" />

    <!-- occ_node -->
    <node pkg="occ-map" type="occ_node2" name="occ_node2" />

    <!-- rviz -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find tf_viz_pkg)/rviz/controller_cone.rviz" />
</launch>